<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent cell wrapper: fills the GridLayoutManager span without stretching the card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Prominent thumbnail at the top of the card ────────────── -->
            <FrameLayout
                android:layout_width="185dp"
                android:layout_height="150dp"
                android:background="#F5F5F5">

                <ImageView
                    android:id="@+id/image_model_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Model thumbnail" />

                <ImageView
                    android:id="@+id/image_model_placeholder"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_no_thumbnail"
                    android:scaleType="center"
                    android:alpha="0.4"
                    android:contentDescription="No thumbnail available" />

                <ProgressBar
                    android:id="@+id/progress_preview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- ── Model info below the thumbnail ────────────────────────── -->
            <LinearLayout
                android:layout_width="185dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/text_model_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Model Name"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/text_model_filename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="filename.glb"
                    android:textSize="11sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="middle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/text_model_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.5 MB"
                        android:textSize="11sp"
                        android:textColor="#888888" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · "
                        android:textSize="11sp"
                        android:textColor="#888888" />

                    <TextView
                        android:id="@+id/text_model_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Added today"
                        android:textSize="11sp"
                        android:textColor="#888888" />

                </LinearLayout>

            </LinearLayout>

            <!-- Thin divider -->
            <View
                android:layout_width="185dp"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="6dp" />

            <!-- ── Compact action buttons at the bottom of the card ───────── -->
            <LinearLayout
                android:layout_width="185dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageButton
                    android:id="@+id/btn_edit_model"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_edit_blue"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Edit Model"
                    android:padding="6dp" />

<!--                <ImageButton-->
<!--                    android:id="@+id/btn_recapture_thumbnail"-->
<!--                    android:layout_width="36dp"-->
<!--                    android:layout_height="36dp"-->
<!--                    android:src="@drawable/ic_camera_orange"-->
<!--                    android:background="?android:attr/selectableItemBackgroundBorderless"-->
<!--                    android:contentDescription="Recapture Thumbnail"-->
<!--                    android:padding="6dp" />-->

                <ImageButton
                    android:id="@+id/btn_delete_model"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_delete_red"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete Model"
                    android:padding="6dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
