<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Generate Coordinates Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateCoords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_coord_generate" />

    <!-- Clear All Coordinates Button — destructive, uses error colors -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearAllCoords"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dev_coord_clear_all"
        app:strokeColor="?attr/colorError"
        android:textColor="?attr/colorError"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dev_status_ready"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <!-- Hint Text -->
    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dev_coord_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
