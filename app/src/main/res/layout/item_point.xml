<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/foreground_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@android:color/white">

    <ImageView
        android:id="@+id/point_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/menu_view_coordinates" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/point_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/point_coordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/point_edit"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/edit_coordinate"
        android:textColor="@android:color/white"
        android:background="@android:color/holo_blue_light"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/point_delete"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="@string/delete_coordinate"
        android:textColor="@android:color/white"
        android:background="@android:color/holo_red_light" />
</LinearLayout>
