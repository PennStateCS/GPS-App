<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Location Source Selection (Radio Buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="8dp">

        <RadioGroup
            android:id="@+id/radio_location_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/radio_internal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Internal GPS"
                android:layout_marginBottom="8dp" />
            <RadioButton
                android:id="@+id/radio_es2_tcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emlid Reach RS2+ (TCP)"
                android:layout_marginBottom="8dp" />
        </RadioGroup>

        <!-- Options for Emlid Reach RS2+ (TCP): inline manual entry -->
        <LinearLayout
            android:id="@+id/layout_rs2_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_host"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="textUri"
                    android:hint="@string/hint_host"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/edit_port"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="@string/hint_port"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connect" />
            </LinearLayout>
        </LinearLayout>

        <!-- Selected Device Container (enhanced with device information) -->
        <LinearLayout
            android:id="@+id/container_selected_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@drawable/bg_device_box">

            <!-- Device Header with Status and Disconnect Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- Status and Disconnect Button Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_device_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/disconnected"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/darker_gray"
                        android:gravity="start" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_device_status"
                            android:layout_width="200dp"
                            android:layout_height="73dp"
                            android:src="@drawable/ic_device_status"
                            android:scaleType="centerInside"
                            android:contentDescription="Device status icon" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_disconnect_device"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disconnect"
                            android:backgroundTint="@android:color/holo_red_dark"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Device Information Panel -->
            <LinearLayout
                android:id="@+id/device_info_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/bg_rounded_light"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <!-- Basic Device Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Left Column: Device Name and IP Address -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Name: "
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black" />
                            <TextView
                                android:id="@+id/text_device_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textSize="12sp"
                                android:textColor="@android:color/black" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IP: "
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black" />
                            <TextView
                                android:id="@+id/text_device_ip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="--"
                                android:textSize="12sp"
                                android:textColor="@android:color/black" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right Column: Model & Firmware -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/layout_device_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Model: "
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black" />
                            <TextView
                                android:id="@+id/text_device_model"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:textColor="@android:color/black" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_device_firmware"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Firmware: "
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/black" />
                            <TextView
                                android:id="@+id/text_device_firmware"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:textColor="@android:color/black" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Self Tests Section -->
                <LinearLayout
                    android:id="@+id/layout_self_tests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/bg_rounded_card"
                    android:padding="8dp">

                    <!-- Self Tests Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System Self Tests"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/text_self_tests_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/holo_green_dark" />
                    </LinearLayout>

                    <!-- Self Tests Grid Container -->
                    <LinearLayout
                        android:id="@+id/layout_self_tests_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Tests will be added dynamically in columns -->

                    </LinearLayout>

                </LinearLayout>

                <!-- Single Action Button (Refresh Only) -->
                <Button
                    android:id="@+id/btn_refresh_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Refresh Device Information"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- RS2+ diagnostic tools have been moved to Development > RS2+ -->

    </LinearLayout>

    <!-- Internal GPS Settings -->
    <LinearLayout
        android:id="@+id/group_internal_gps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_high_accuracy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High Accuracy Location"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/text_high_accuracy_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable this to use the device's most precise location mode, which may use GPS and other sensors. May increase battery usage."
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@android:color/darker_gray" />

    </LinearLayout>

    <!-- ── Section: Connection Behavior ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connection Behavior"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_auto_reconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-Reconnect"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatically attempt to reconnect when a TCP connection to the external receiver is lost."
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_validate_nmea_checksum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Validate NMEA Checksum"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reject NMEA sentences that fail the XOR checksum. Disable only if you are using a non-standard receiver that emits invalid checksums."
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connection Timeout (seconds)"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_connection_timeout_sec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seconds to wait for a TCP connection before reporting a failure. Range: 5–60 s. Default: 10 s."
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max Reconnect Attempts"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_max_reconnect_attempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maximum number of automatic reconnect attempts before giving up. Range: 1–20. Default: 5."
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_save_connection_behavior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:minHeight="48dp" />

    </LinearLayout>

</LinearLayout>
