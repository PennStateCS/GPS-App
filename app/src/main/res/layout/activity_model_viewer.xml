<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.models.ModelViewerActivity">

    <!-- App Bar -->
    <!-- Same top-bar colours as the main screen (app_bar_main.xml) so the title and back
         arrow are clearly visible in light and dark themes. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_top_app_bar"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/app_top_app_bar"
            app:titleTextColor="@color/app_on_top_app_bar"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium"
            app:navigationIconTint="@color/app_on_top_app_bar"
            app:popupTheme="@style/Theme.SurveyingApp.PopupOverlay"
            app:buttonGravity="center_vertical"
            app:title="Model Viewer" />
        <!-- buttonGravity: the back button is sized from ?attr/actionBarSize (64dp in Material 3) and
             top-aligned by default, so in this 56dp bar it sat below the title's centre line. -->

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 3D Scene View -->
        <!-- Placeholder view removed; SurfaceView below is the rendering surface -->

        <SurfaceView
            android:id="@+id/modelSurface"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Fixed light grey on purpose: matches the Filament skybox/clear colour (BACKGROUND_GREY in
             ModelViewerActivity, same in both themes) so the reveal does not flash. Text over it uses the
             fixed model_viewer_on_canvas colours, not the theme's onSurface. -->
        <View
            android:id="@+id/loading_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/model_viewer_canvas"
            app:layout_constraintBottom_toBottomOf="@id/modelSurface"
            app:layout_constraintEnd_toEndOf="@id/modelSurface"
            app:layout_constraintStart_toStartOf="@id/modelSurface"
            app:layout_constraintTop_toTopOf="@id/modelSurface" />

        <!-- Loading Progress (hidden by default) -->
        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/model_viewer_on_canvas_accent"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/modelSurface"
            app:layout_constraintEnd_toEndOf="@id/modelSurface"
            app:layout_constraintStart_toStartOf="@id/modelSurface"
            app:layout_constraintTop_toTopOf="@id/modelSurface" />

        <!-- Loading Label (hidden once the model is revealed) -->
        <TextView
            android:id="@+id/text_loading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.BodyPrimary"
            android:textColor="@color/model_viewer_on_canvas"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="@id/modelSurface"
            app:layout_constraintStart_toStartOf="@id/modelSurface"
            app:layout_constraintTop_toBottomOf="@id/progress_loading"
            tools:text="Now loading PLACEHOLDER" />

        <!-- Error Message -->
        <TextView
            android:id="@+id/text_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:gravity="center"
            android:text="@string/failed_load_model"
            android:textColor="@color/model_viewer_on_canvas_error"
            android:textAppearance="@style/TextAppearance.App.BodyPrimary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/modelSurface"
            app:layout_constraintEnd_toEndOf="@id/modelSurface"
            app:layout_constraintStart_toStartOf="@id/modelSurface"
            app:layout_constraintTop_toTopOf="@id/modelSurface" />

        <!-- Name Container -->
        <LinearLayout
            android:id="@+id/name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_rounded_tab_floating"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Model Info -->
            <TextView
                android:id="@+id/text_model_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.PageTitle"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Model Name" />

            <TextView
                android:id="@+id/text_model_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textStyle="bold"
                tools:text="Model Filename" />

            <!-- Shown while "Show AR Placement" is on: which point / preset the overlay uses -->
            <TextView
                android:id="@+id/text_ar_placement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="AR placement: Point 5 · Center" />
        </LinearLayout>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_capture_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="115dp"
            app:backgroundTint="?attr/colorPrimary"
            app:borderWidth="0dp"
            app:srcCompat="@drawable/ic_camera_white"
            app:tint="?attr/colorOnPrimary"
            app:maxImageSize="50dp"
            android:layout_margin="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_controls_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="75dp"
            app:backgroundTint="?attr/colorPrimary"
            app:borderWidth="0dp"
            app:srcCompat="@drawable/ic_zoom_in"
            app:tint="?attr/colorOnPrimary"
            app:maxImageSize="35dp"
            android:layout_margin="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_viewer_controls"
            style="@style/Widget.App.Card.Elevated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:visibility="invisible"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/btn_controls_expand"
            app:layout_constraintEnd_toEndOf="@id/btn_controls_expand"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_viewer_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="4dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="9"
                tools:listitem="@layout/item_model_viewer_control" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
