<?xml version="1.0" encoding="utf-8"?>
<!-- AR model-visibility bottom sheet. Compact, non-blocking (camera stays visible behind).
     Mode + range chips are populated in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="16dp"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="?android:attr/textColorSecondary"
        android:alpha="0.35" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Visible Models"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/txtArModelsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:text="0 shown · 0 nearby" />

    <TextView
        android:id="@+id/txtArModelsWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/app_warning"
        android:visibility="gone"
        android:text="Showing many models may reduce AR performance." />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Display mode"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupArMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleLine="true"
        app:singleSelection="true"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShowAllNearby"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Show all nearby"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnHideAll"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hide all"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnResetToMap"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Use map selection"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtArRangeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Range"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupArRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleLine="true"
        app:singleSelection="true"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listArModels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:minHeight="120dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
