<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceViewAr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true" />

    <!-- 2-D text labels projected above each geospatial pin.
         Non-clickable so touches pass through to the GLSurfaceView. -->
    <com.example.surveyingapp.ui.openinar.CoordinateLabelOverlay
        android:id="@+id/labelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Filament renders GLB models here with a transparent background,
         composited on top of the camera GLSurfaceView below.
         layerType=HARDWARE ensures the view is composited via hardware with alpha blending.
         opaque="false" is set programmatically in ArFilamentRenderer.init(); here we
         pre-set the layer type so the TextureView never flashes opaque before init. -->
    <TextureView
        android:id="@+id/filamentSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layerType="hardware"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Debug: spawn / clear test anchor rings around current position -->
    <Button
        android:id="@+id/btnSpawnTestPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:text="📍 Test Points"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:backgroundTint="#CC1565C0"
        android:textColor="#FFFFFF"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/textArStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#66000000"
        android:textColor="#FFFFFF"
        android:text="Initializing AR..."
        android:layout_gravity="top|center_horizontal"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Debug panel: shows Earth state, anchor count, pin distances, model load state.
         Positioned at the bottom so it doesn't overlap the camera view area. -->
    <TextView
        android:id="@+id/textArDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="10dp"
        android:background="#BB000000"
        android:textColor="#FFFF00"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:text="Debug: initializing..."
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

</FrameLayout>
