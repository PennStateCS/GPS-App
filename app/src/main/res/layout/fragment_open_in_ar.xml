<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceViewAr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true" />

    <!-- 2-D text labels projected above each geospatial pin. -->
    <com.example.surveyingapp.ui.openinar.CoordinateLabelOverlay
        android:id="@+id/labelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Filament GLB model overlay (transparent, hardware composited). -->
    <TextureView
        android:id="@+id/filamentSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layerType="hardware"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Off-screen pin arrows at screen edges. -->
    <com.example.surveyingapp.ui.openinar.OffScreenPinIndicatorOverlay
        android:id="@+id/offScreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- ── Floating toolbar ───────────────────────────────────────────────── -->

    <!--
        Toggle button — always visible in the top-right corner.
        Tapping shows or hides the full toolbar card below it.
    -->
    <ImageButton
        android:id="@+id/btnToolbarToggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_ar_menu"
        android:background="#CC000000"
        android:scaleType="center"
        android:padding="10dp"
        android:contentDescription="Toggle AR toolbar"
        android:clickable="true"
        android:focusable="true" />

    <!-- Model load progress chip — anchored just below the toggle button. -->
    <TextView
        android:id="@+id/chipModelProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:text="⏳ 0/0 models"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:background="@drawable/bg_ar_chip"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <!--
        Floating icon toolbar card.
        Hidden by default (GONE). The toggle button slides it in/out with a
        translationX animation so it never overlaps the camera feed unnecessarily.

        Each item: 24dp icon + 9sp label, separated by subtle dividers.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/arFloatingToolbar"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Reanchor -->
            <LinearLayout
                android:id="@+id/btnReanchor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Re-anchor">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_refresh_24_white"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Anchor"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#33FFFFFF" android:layout_marginHorizontal="8dp" />

            <!-- Test Points -->
            <LinearLayout
                android:id="@+id/btnSpawnTestPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Spawn test points">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pin"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtTestPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Test"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#33FFFFFF" android:layout_marginHorizontal="8dp" />

            <!-- Distance Filter -->
            <LinearLayout
                android:id="@+id/btnDistanceFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Distance filter">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ar_filter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtDistanceFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="All"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#33FFFFFF" android:layout_marginHorizontal="8dp" />

            <!-- Altitude Mode -->
            <LinearLayout
                android:id="@+id/btnAltitudeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Altitude mode">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ar_altitude"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtAltitudeMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Stored"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#33FFFFFF" android:layout_marginHorizontal="8dp" />

            <!-- Debug Overlay -->
            <LinearLayout
                android:id="@+id/btnToggleDebugOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle debug overlay">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ar_debug"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtDebugOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Debug"
                    android:textSize="9sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Debug panel (shown via debug toggle) ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/debugPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textArStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#66000000"
            android:textColor="#FFFFFF"
            android:text="Initializing AR..."
            android:gravity="center_horizontal"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/textArDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="#BB000000"
            android:textColor="#FFFF00"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="Debug: initializing..."
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />

    </LinearLayout>

</FrameLayout>
