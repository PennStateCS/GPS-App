<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceViewAr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true" />

    <!-- 2-D text labels projected above each geospatial pin. -->
    <app.surrealar.ui.openinar.CoordinateLabelOverlay
        android:id="@+id/labelOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Filament GLB model overlay (transparent, hardware composited). -->
    <TextureView
        android:id="@+id/filamentSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layerType="hardware"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Off-screen pin arrows at screen edges. -->
    <app.surrealar.ui.openinar.OffScreenPinIndicatorOverlay
        android:id="@+id/offScreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Prominent centred "Localizing AR" banner. Shown while model-linked coordinates are being
         held (anchors not yet committed) so the user knows AR is still locating and doesn't mistake
         the delay for the models rendering on top of them. Hidden once anchors are placed. -->
    <LinearLayout
        android:id="@+id/localizingBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="320dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_ar_chip"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="8dp"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="yes"
        android:contentDescription="Localizing AR, hold steady">

        <ProgressBar
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/ar_overlay_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLocalizingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Localizing AR…"
                android:textColor="@color/ar_overlay_text"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/txtLocalizingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Hold steady and point the camera at nearby buildings, trees, or ground features."
                android:textColor="@color/ar_overlay_text"
                android:textSize="12sp"
                android:alpha="0.85" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact, persistent AR-view-quality chip. Shown AFTER anchors are placed (the banner is for
         the pre-placement phase). Reports ARCore geospatial (AR) confidence + horizontal accuracy —
         distinct from the GNSS fix chip below the Back button. -->
    <TextView
        android:id="@+id/chipArQuality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="98dp"
        android:layout_marginStart="12dp"
        android:text="AR quality: —"
        android:textColor="@color/ar_overlay_text"
        android:textSize="11sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:background="@drawable/bg_ar_chip"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- ── Floating toolbar ───────────────────────────────────────────────── -->

    <!-- Back button — top-left, always visible, exits AR -->
    <LinearLayout
        android:id="@+id/btnArBack"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_ar_chip"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Exit AR">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ar_overlay_text"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="Back"
            android:textColor="@color/ar_overlay_text"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- AR GNSS status chip — top-left, below Back button -->
    <TextView
        android:id="@+id/chipArGnssStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="68dp"
        android:layout_marginStart="12dp"
        android:text="Acquiring…"
        android:textColor="@color/ar_overlay_text"
        android:textSize="11sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:background="@drawable/bg_ar_chip"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!--
        Toggle button — always visible in the top-right corner.
        Tapping shows or hides the full toolbar card below it.
    -->
    <ImageButton
        android:id="@+id/btnToolbarToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_tune_24"
        android:background="@drawable/bg_ar_chip"
        android:scaleType="center"
        android:padding="12dp"
        android:contentDescription="Show AR tools"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Model load progress chip — top centre, above the floating toolbar. -->
    <TextView
        android:id="@+id/chipModelProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:text="⏳ 0/0 models"
        android:textAppearance="@style/TextAppearance.App.AR.Overlay"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:background="@drawable/bg_ar_chip"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false" />

    <!--
        Floating icon toolbar card.
        Hidden by default (GONE). The toggle button slides it in/out with a
        translationX animation so it never overlaps the camera feed unnecessarily.

        Each item: 24dp icon + 9sp label, separated by subtle dividers.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/arFloatingToolbar"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        style="@style/Widget.App.AR.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Reanchor -->
            <LinearLayout
                android:id="@+id/btnReanchor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Re-anchor">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_refresh_24_white"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Anchor"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Test Points -->
            <LinearLayout
                android:id="@+id/btnSpawnTestPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Spawn test points">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pin"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtTestPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Test"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Distance Filter -->
            <LinearLayout
                android:id="@+id/btnDistanceFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Visible models">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_models_24"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtDistanceFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="All"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Altitude Mode -->
            <LinearLayout
                android:id="@+id/btnAltitudeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Altitude mode">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ar_altitude"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/txtAltitudeMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Stored"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Debug tools group: hidden unless AR Debug Tools setting is on -->
            <LinearLayout
                android:id="@+id/arDebugToolsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

                <!-- Planes toggle -->
                <LinearLayout
                    android:id="@+id/btnTogglePlanes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/ripple_ar_toolbar_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Show detected planes">
                    <ImageView
                        android:id="@+id/iconTogglePlanes"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ar_menu"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/txtTogglePlanes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Planes"
                        android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                        android:gravity="center" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

                <!-- Point cloud toggle -->
                <LinearLayout
                    android:id="@+id/btnTogglePointCloud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/ripple_ar_toolbar_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Show AR point cloud">
                    <ImageView
                        android:id="@+id/iconTogglePointCloud"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_satellite_24"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/txtTogglePointCloud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Points"
                        android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                        android:gravity="center" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

                <!-- Debug Overlay toggle -->
                <LinearLayout
                    android:id="@+id/btnToggleDebugOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/ripple_ar_toolbar_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Show AR debug overlay">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ar_debug"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/txtDebugOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Debug"
                        android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Debug panel (shown via debug toggle) ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/debugPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textArStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@color/ar_overlay_bg_medium"
            android:textAppearance="@style/TextAppearance.App.AR.Overlay"
            android:text="Initializing AR..."
            android:gravity="center_horizontal"
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <TextView
            android:id="@+id/textArDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="@color/ar_overlay_bg_heavy"
            android:textAppearance="@style/TextAppearance.App.AR.Alert"
            android:fontFamily="monospace"
            android:text="Debug: initializing..."
            android:clickable="false"
            android:focusable="false"
            android:focusableInTouchMode="false" />

    </LinearLayout>

</FrameLayout>
