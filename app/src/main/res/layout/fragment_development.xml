<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permissions Status"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/text_permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking permissions..."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:background="@android:color/background_light"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_refresh_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Permission Status"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_request_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Request Location Permissions"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@android:color/holo_orange_light" />

    <Button
        android:id="@+id/btn_fake_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Fake Points"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_clear_all_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear All Points"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@android:color/holo_red_light" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This page contains development and testing tools for the surveying app."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray" />

</LinearLayout>
