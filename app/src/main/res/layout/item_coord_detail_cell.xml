<?xml version="1.0" encoding="utf-8"?>
<!-- One label/value cell for the two-column tablet variant of coordinate detail cards.
     Two of these sit side by side in a horizontal row (each weight 1). The label sits above the
     value so long labels/values wrap cleanly in a narrow column. Inflated by
     CoordinateDetailFragment.renderDetailRows() on sw600dp+; phones use item_coord_detail_row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:minHeight="44dp"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/cell_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/cell_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
