<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <!-- Optional icon, can hide if not needed -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        app:tint="@color/toolbar_on_primary"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_satellite_24"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acc"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.App.Toolbar.Label"
        android:maxLines="1" />

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textAppearance="@style/TextAppearance.App.Toolbar.Value"
        android:layout_marginStart="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no" />

    <!-- Vertical bar separator with equal margins on both sides -->
    <TextView
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="|"
        android:importantForAccessibility="no"
        android:textColor="@color/app_status_separator"
        android:textSize="14sp" />
</LinearLayout>
