<?xml version="1.0" encoding="utf-8"?>
<!-- Category item layout for settings left panel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="0dp"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:minHeight="56dp">

    <View
        android:id="@+id/category_accent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/dev_category_selected_accent"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/category_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/dev_category_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/category_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_menu_camera"
            android:contentDescription="@string/dev_category_icon_desc" />

        <TextView
            android:id="@+id/category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Category Name"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
