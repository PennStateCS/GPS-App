<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- App Info Section -->
    <TextView
        android:id="@+id/appInfoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_section_app_info"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:paddingBottom="8dp" />

    <!-- App info table container - populated programmatically -->
    <LinearLayout
        android:id="@+id/appInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical" />

    <!-- Device Info Section -->
    <TextView
        android:id="@+id/deviceInfoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_section_device_info"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:paddingBottom="8dp" />

    <!-- Device info table container - populated programmatically -->
    <LinearLayout
        android:id="@+id/deviceInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
