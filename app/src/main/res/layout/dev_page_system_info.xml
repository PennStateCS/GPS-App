<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingStart="@dimen/settings_content_padding_h"
    android:paddingEnd="@dimen/settings_content_padding_h">

    <!-- Page title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_page_title_system_info"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <!-- Page subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.7"
        android:text="@string/dev_page_subtitle_system_info"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- App info card container - populated programmatically -->
    <LinearLayout
        android:id="@+id/appInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Device info card container - populated programmatically -->
    <LinearLayout
        android:id="@+id/deviceInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
