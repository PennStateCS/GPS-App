<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- App Info Section -->
    <TextView
        android:id="@+id/appInfoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_section_app_info"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/dev_info_label"
        android:paddingTop="24dp"
        android:paddingBottom="12dp" />

    <!-- App info table container - will be populated programmatically -->
    <LinearLayout
        android:id="@+id/appInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Device Info Section -->
    <TextView
        android:id="@+id/deviceInfoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_section_device_info"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/dev_info_label"
        android:paddingTop="24dp"
        android:paddingBottom="12dp" />

    <!-- Device info table container - will be populated programmatically -->
    <LinearLayout
        android:id="@+id/deviceInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
