<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/edit_point_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Point Name" />

        <EditText
            android:id="@+id/edit_point_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:hint="Note / description (optional)" />

        <TextView
            android:id="@+id/text_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: (fetching...)"
            android:paddingTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Icon:" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_icon"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="18sp"
            android:text="Choose a model..."
            app:icon="@android:color/transparent"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:textColor="?attr/colorOnSurface"
            app:strokeColor="?attr/colorOutlineVariant"
            app:rippleColor="?attr/colorControlHighlight" />

        <!-- Model placement: shown only when a model is linked; collapsed by default. -->
        <LinearLayout
            android:id="@+id/section_model_placement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/header_model_placement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="▸ Model placement"
                android:textColor="?attr/colorPrimary"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/body_model_placement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText android:id="@+id/edit_model_scale"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberDecimal" android:hint="Scale (×, blank = model default)" />
                <EditText android:id="@+id/edit_model_yaw"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Yaw (°)" />
                <EditText android:id="@+id/edit_model_pitch"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Pitch (°)" />
                <EditText android:id="@+id/edit_model_roll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Roll (°)" />
                <EditText android:id="@+id/edit_model_voffset"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Vertical offset (m)" />
                <EditText android:id="@+id/edit_model_offx"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Origin offset X (m)" />
                <EditText android:id="@+id/edit_model_offy"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Origin offset Y (m)" />
                <EditText android:id="@+id/edit_model_offz"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="numberSigned|numberDecimal" android:hint="Origin offset Z (m)" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

