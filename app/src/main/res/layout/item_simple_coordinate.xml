<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:clipToOutline="false">

    <View
        android:id="@+id/selection_accent"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:background="@color/dev_category_selected_accent"
        android:outlineProvider="none"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/coordinate_row_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/coordinate_item_bg"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:clipToOutline="false">

        <ImageView
            android:id="@+id/image_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/icon_content_desc"
            android:src="@drawable/ic_menu_camera" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clipToOutline="false">

            <TextView
                android:id="@+id/text_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_coords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.Supporting"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Edit button -->
    <ImageButton
        android:id="@+id/button_edit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:layout_marginEnd="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit_coordinate"
        android:src="@drawable/ic_edit_blue"
        app:tint="#0D47A1" />

    <!-- Delete (trash) button -->
    <ImageButton
        android:id="@+id/button_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_coordinate"
        android:src="@drawable/ic_delete_red"
        app:tint="#B71C1C" />
</LinearLayout>
