<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Refresh bar container - will be populated programmatically -->
    <LinearLayout
        android:id="@+id/refreshBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- Permissions table container - will be populated programmatically -->
    <LinearLayout
        android:id="@+id/permissionsTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Request Core Permissions Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRequestCorePermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:text="@string/dev_request_core_permissions" />

</LinearLayout>
