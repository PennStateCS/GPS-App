<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Refresh bar container - populated programmatically -->
    <LinearLayout
        android:id="@+id/refreshBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- Permissions table container - populated programmatically -->
    <LinearLayout
        android:id="@+id/permissionsTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Request Core Permissions Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRequestCorePermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dev_request_core_permissions" />

</LinearLayout>
