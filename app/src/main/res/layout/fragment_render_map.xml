<?xml version="1.0" encoding="utf-8"?>
<!--
    Map workspace. All panels overlay the full-screen MapView.
    Key ID contracts (referenced by RenderMapFragment.kt):
      mapView, text_render_map
      left_panel, panel_handle (GONE compat), btn_collapse_panel, btn_expand_panel
      left_panel_subtitle, left_panel_placeholder
      coordinate_toggle_list, btn_show_all, btn_hide_all
      Map Tools overlay: btnMapToolsToggle, layoutMapTools, and rows
        btnMapType, btnMapCenter, btnMapGrid, btnMapZoomIn, btnMapZoomOut,
        btnMapCompass, btnMapFit
      card_selected_coordinate, img_selected_icon, txt_selected_name,
        txt_selected_subtitle, btn_selected_close, btn_selected_center, btn_selected_stakeout
      stakeout_panel, txt_stakeout_target, txt_stakeout_distance, txt_stakeout_bearing,
        btn_clear_stakeout, btn_toggle_stakeout (GONE compat)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Full-screen map ─────────────────────────────────────────────── -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Placeholder when no map loaded (normally gone) -->
    <TextView
        android:id="@+id/text_render_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_ar_chip"
        android:padding="12dp"
        android:text="@string/render_map_placeholder"
        android:textColor="@color/ar_overlay_text"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- ── Hidden compatibility stubs ──────────────────────────────────── -->
    <View
        android:id="@+id/panel_handle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_toggle_stakeout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Stakeout"
        android:visibility="gone" />

    <!-- ══════════════════════════════════════════════════════════════════
         LEFT: Floating coordinate panel
    ══════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/left_panel"
        style="@style/Widget.App.Card.Outlined"
        android:layout_width="272dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        app:cardElevation="6dp"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <!-- Panel header: title + visibility menu + collapse button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Map Points"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/left_panel_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading…"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_visibility_menu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Coordinate visibility options"
                    android:src="@drawable/ic_visibility_24"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/btn_collapse_panel"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Hide coordinates panel"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="180"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Subtle divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/colorOutlineVariant"
                android:alpha="0.6" />

            <!-- Scrollable coordinate list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/coordinate_toggle_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="340dp"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Empty state (shown in-panel when there are no saved points) -->
            <LinearLayout
                android:id="@+id/left_panel_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/left_panel_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No saved points to show"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Capture or import coordinates, then return to this map."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Panel expand button: appears when panel is collapsed -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_expand_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:text="Coordinates"
        android:contentDescription="Show coordinates panel"
        app:icon="@drawable/ic_list_coordinates"
        android:visibility="gone" />

    <!-- ══════════════════════════════════════════════════════════════════
         TOP-END: Map Tools toggle + collapsible overlay toolbar
         (Modeled on the AR floating toolbar — reuses the same overlay
         resources. The app-wide toolbar owns GNSS/source/fix/accuracy, so
         the map no longer shows a GNSS status chip.)
    ══════════════════════════════════════════════════════════════════ -->
    <!-- Always-visible one-tap Recenter (Center also remains inside Map Tools). Sits just left of
         the toggle so it stays clear of the toolbar panel when it slides out below the toggle. -->
    <ImageButton
        android:id="@+id/btnMapRecenter"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="66dp"
        android:src="@drawable/ic_my_location_24"
        android:background="@drawable/bg_ar_chip"
        android:scaleType="center"
        android:padding="12dp"
        android:contentDescription="Recenter map"
        android:elevation="4dp"
        app:tint="@color/ar_overlay_text"
        android:clickable="true"
        android:focusable="true" />

    <ImageButton
        android:id="@+id/btnMapToolsToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_ar_menu"
        android:background="@drawable/bg_ar_chip"
        android:scaleType="center"
        android:padding="12dp"
        android:contentDescription="Show map tools"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutMapTools"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        style="@style/Widget.App.AR.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Type (map type / layers) -->
            <LinearLayout
                android:id="@+id/btnMapType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Change map type">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_layers_24"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Type"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Center (recenter on my location) -->
            <LinearLayout
                android:id="@+id/btnMapCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Recenter map">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_my_location_24"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Center"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Grid (toggle coordinate grid) -->
            <LinearLayout
                android:id="@+id/btnMapGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Toggle coordinate grid">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_grid_24"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Grid"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Zoom in -->
            <LinearLayout
                android:id="@+id/btnMapZoomIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Zoom in">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_zoom_in"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="In"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Zoom out -->
            <LinearLayout
                android:id="@+id/btnMapZoomOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Zoom out">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_zoom_out"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Out"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Compass (reset map orientation) -->
            <LinearLayout
                android:id="@+id/btnMapCompass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Reset map orientation">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_compass_24"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="North"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/ar_overlay_divider" android:layout_marginHorizontal="8dp" />

            <!-- Fit visible coordinates -->
            <LinearLayout
                android:id="@+id/btnMapFit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/ripple_ar_toolbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Fit visible coordinates">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fit_screen_24"
                    android:tint="@color/ar_overlay_text"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Fit"
                    android:textAppearance="@style/TextAppearance.App.AR.OverlaySmall"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════════════
         BOTTOM-START: Selected coordinate card
    ══════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_selected_coordinate"
        style="@style/Widget.App.Card.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="12dp"
        app:cardElevation="8dp"
        app:cardCornerRadius="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <!-- Icon + name + subtitle + close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/img_selected_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Coordinate icon"
                    android:src="@drawable/ic_pin" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_selected_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/txt_selected_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_selected_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close selected coordinate card"
                    android:src="@drawable/ic_arrow_back"
                    android:rotation="90"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_selected_center"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Center"
                    android:contentDescription="Center map on this coordinate"
                    app:icon="@drawable/ic_my_location_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_selected_stakeout"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stakeout"
                    android:contentDescription="Start stakeout"
                    app:icon="@drawable/ic_stakeout_24" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════════════
         BOTTOM-CENTER: Stakeout mode panel (shown when stakeout active)
    ══════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stakeout_panel"
        style="@style/Widget.App.Card.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="12dp"
        app:cardElevation="8dp"
        app:cardCornerRadius="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title row: "Stakeout" label + Stop button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_stakeout_24"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Stakeout active" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stakeout Target"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_stakeout"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="Clear Target"
                    android:contentDescription="Clear stakeout target"
                    android:textColor="?attr/colorError" />

            </LinearLayout>

            <!-- Target name -->
            <TextView
                android:id="@+id/txt_stakeout_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:paddingBottom="12dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Guidance arrow (rotates toward the target; visible only in guidance mode) -->
            <ImageView
                android:id="@+id/img_stakeout_arrow"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_stakeout_arrow"
                android:contentDescription="Direction to stakeout target"
                android:visibility="gone" />

            <!-- Distance + Bearing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/txt_stakeout_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bearing"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/txt_stakeout_bearing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                </LinearLayout>

            </LinearLayout>

            <!-- North/East deltas (display-only; metres) -->
            <TextView
                android:id="@+id/txt_stakeout_delta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="—"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontFamily="monospace"
                android:gravity="center" />

            <!-- Live state line: Waiting… / Move <direction> / Within tolerance -->
            <TextView
                android:id="@+id/txt_stakeout_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Waiting for live position…"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center" />

            <!-- Horizontal accuracy (the only GNSS detail shown here; turns to a warning when poor) -->
            <TextView
                android:id="@+id/txt_stakeout_accuracy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Tolerance (shown in guidance mode) -->
            <TextView
                android:id="@+id/txt_stakeout_tolerance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Heading-unavailable note (shown when the arrow falls back to north-up) -->
            <TextView
                android:id="@+id/txt_stakeout_heading_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Arrow is north-up until heading is available."
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="italic"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Start / Stop guidance -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stakeout_guidance"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Start Guidance"
                android:contentDescription="Start stakeout guidance" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
