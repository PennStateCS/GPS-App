<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left column panel -->
    <LinearLayout
        android:id="@+id/left_panel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/left_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingBottom="8dp"
                android:text="Coordinates"
                android:textAppearance="@style/TextAppearance.App.SectionTitle"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_collapse_panel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Collapse"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- Show/Hide All Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btn_show_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="Show All"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btn_hide_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="Hide All"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Stakeout Panel -->
        <LinearLayout
            android:id="@+id/stakeout_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stakeout"
                    android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear_stakeout"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="8dp"
                    android:text="Clear"
                    android:textColor="?attr/colorError"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_stakeout_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Target: Tap map to set"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="@style/TextAppearance.App.Supporting" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txt_stakeout_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bearing"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txt_stakeout_bearing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.App.BodyPrimary"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Stakeout Toggle Button -->
        <Button
            android:id="@+id/btn_toggle_stakeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="Enable Stakeout"
            android:textColor="?attr/colorSecondary"
            android:textAppearance="@style/TextAppearance.App.Supporting" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/coordinate_toggle_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/left_panel_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No coordinates"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="@style/TextAppearance.App.BodySecondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Slim drag handle (4dp) -->
    <View
        android:id="@+id/panel_handle"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/panel_handle_grip"
        android:contentDescription="Drag handle" />

    <!-- Right side map container -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- GNSS source / RTK status chip – top-left of map -->
        <TextView
            android:id="@+id/text_gnss_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@color/ar_overlay_bg_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="GNSS: --"
            android:textColor="@color/ar_overlay_text"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:visibility="visible" />

        <TextView
            android:id="@+id/text_render_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/ar_overlay_bg_medium"
            android:padding="12dp"
            android:text="@string/render_map_placeholder"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_sat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:contentDescription="Toggle satellite"
            android:src="@android:drawable/ic_menu_gallery" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_recenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Recenter map"
            android:src="@android:drawable/ic_menu_mylocation" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_zoom_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:contentDescription="Zoom in"
            android:src="@drawable/ic_zoom_in" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_zoom_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="144dp"
            android:contentDescription="Zoom out"
            android:src="@drawable/ic_zoom_out" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="200dp"
            android:contentDescription="Toggle coordinate grid"
            android:src="@android:drawable/ic_menu_view" />

        <!-- Expand button appears when panel collapsed -->
        <ImageButton
            android:id="@+id/btn_expand_panel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:layout_margin="8dp"
            android:background="@color/map_overlay_bg"
            android:contentDescription="Expand panel"
            android:elevation="4dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="?attr/colorControlNormal"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>