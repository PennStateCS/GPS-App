<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left column panel -->
    <LinearLayout
        android:id="@+id/left_panel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/left_panel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Points"
                android:textStyle="bold"
                android:textSize="18sp"
                android:paddingBottom="8dp" />
            <ImageButton
                android:id="@+id/btn_collapse_panel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Collapse"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/left_panel_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="List / controls placeholder"
            android:textSize="14sp"
            android:textColor="#555555" />

        <!-- Future list / controls -->
    </LinearLayout>

    <!-- Drag handle between panels -->
    <View
        android:id="@+id/panel_handle"
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:background="@drawable/panel_edge_shadow" />

    <!-- Right side map container -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/text_render_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/render_map_placeholder"
            android:textSize="18sp"
            android:background="#66000000"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_toggle_sat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:contentDescription="Toggle satellite"
            android:src="@android:drawable/ic_menu_gallery" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_recenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Recenter map"
            android:src="@android:drawable/ic_menu_mylocation" />

        <!-- Expand button appears when panel collapsed -->
        <ImageButton
            android:id="@+id/btn_expand_panel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:layout_margin="8dp"
            android:background="#AAFFFFFF"
            android:contentDescription="Expand panel"
            android:src="@android:drawable/ic_input_add"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
