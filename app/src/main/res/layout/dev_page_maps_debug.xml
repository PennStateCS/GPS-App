<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Refresh bar container - populated programmatically -->
    <LinearLayout
        android:id="@+id/refreshBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- Maps info table container - populated programmatically -->
    <LinearLayout
        android:id="@+id/mapsInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical" />

    <!-- API Key Controls -->
    <LinearLayout
        android:id="@+id/apiKeyControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRevealKey"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_reveal_key" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyKey"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/dev_copy_key"
            android:enabled="false" />

    </LinearLayout>

    <!-- API Key Full View -->
    <TextView
        android:id="@+id/apiKeyFullView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textIsSelectable="true"
        android:padding="12dp" />

    <!-- Runtime MapView Test -->
    <FrameLayout
        android:id="@+id/mapViewTestContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp" />

</LinearLayout>
