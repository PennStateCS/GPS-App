<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingStart="@dimen/settings_content_padding_h"
    android:paddingEnd="@dimen/settings_content_padding_h">

    <!-- Page title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dev_page_title_maps_debug"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <!-- Page subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.7"
        android:text="@string/dev_page_subtitle_maps_debug"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- Refresh bar container - populated programmatically -->
    <LinearLayout
        android:id="@+id/refreshBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- Maps info card container - populated programmatically -->
    <LinearLayout
        android:id="@+id/mapsInfoTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- API Key card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/dev_section_api_key"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:id="@+id/apiKeyControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRevealKey"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dev_reveal_key" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyKey"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/dev_copy_key"
                    android:enabled="false" />

            </LinearLayout>

            <TextView
                android:id="@+id/apiKeyFullView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Runtime MapView test -->
    <FrameLayout
        android:id="@+id/mapViewTestContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="4dp" />

</LinearLayout>
