<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="These settings control how coordinates and distances are displayed throughout the app. They do not affect how coordinates are stored."
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <!-- ── Section: Coordinate Format ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coordinate Format"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Display Format"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinner_coordinate_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose between Decimal Degrees (e.g. 43.123456°), Degrees Minutes (e.g. 43° 07.407′), DMS (e.g. 43° 07′ 24.4″), or UTM grid."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <!-- ── Section: Distance Units ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Distance Units"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/spinner_distance_units"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Applies to distance labels in AR and the coordinate list."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <!-- ── Section: Status Indicators ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status Indicators"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_show_accuracy_indicators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show Accuracy Indicators"
        android:minHeight="48dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show horizontal and vertical accuracy circles on saved coordinates."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="16dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_show_rtk_badges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show RTK Status Badges"
        android:minHeight="48dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Display RTK Fix / Float / DGPS badges next to each coordinate in the list."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <!-- ── Section: Coordinate Naming ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coordinate Naming"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Default Name Prefix"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/edit_coordinate_name_prefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:minHeight="48dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The capture dialog pre-fills new coordinate names with this prefix (e.g. Point, TP, BM). Max 20 characters."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="16dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_auto_increment_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto-Increment Coordinate Names"
        android:minHeight="48dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automatically append a number to the default name when the capture dialog opens (e.g. Point 1, Point 2)."
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <!-- Save -->
    <Button
        android:id="@+id/btn_save_coordinate_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"
        android:minHeight="48dp" />

</LinearLayout>
