<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 5 receiver details (ReceiverDetailsSheet). Rows are added to details_rows by the sheet. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp"
            android:text="@string/details_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/details_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details_copy_summary"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/details_copy_summary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details_copy_address"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:minHeight="48dp"
            android:text="@string/details_copy_address" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details_diagnostics"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:minHeight="48dp"
            android:text="@string/details_open_diagnostics" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details_disconnect"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/details_disconnect"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
