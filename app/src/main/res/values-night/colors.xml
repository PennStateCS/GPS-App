<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Night-mode overrides for app-specific semantic colors.
        M3 theme role colors (colorPrimary, colorSurface, etc.) are overridden
        in values-night/themes.xml and do not need to appear here.
    -->

    <!-- App semantic colors – dark overrides -->
    <!-- Top app bar stays the darkest layer; status strip is a lighter slate band (#2A4158, same as light).
         on-strip roles mirror light mode (value near-white, label soft blue-gray, subtle separator)
         since the strip background is dark in both themes. -->
    <color name="app_top_app_bar">#171F2D</color>
    <color name="app_on_top_app_bar">#FFFFFF</color>
    <color name="app_status_strip">#2A4158</color>
    <color name="app_status_separator">#7D93A8</color>

    <!-- Semantic status roles – night. Foregrounds are light tones (≥ 6.8:1 on every dark surface
         up to surface_container_highest); containers are deep tones with light on-container text.
         Old values failed: error #D32F2F 3.6:1 and info #1976D2 3.9:1 on #101820.
         app_success/app_warning/app_error/app_info alias these from values/colors.xml. -->
    <color name="status_success">#7DD6A7</color>
    <color name="status_success_container">#1F4A36</color>
    <color name="status_on_success_container">#C9F2DC</color>
    <color name="status_warning">#F2C26B</color>
    <color name="status_warning_container">#54401A</color>
    <color name="status_on_warning_container">#FCE4B4</color>
    <color name="status_error">#F29A9A</color>
    <color name="status_error_container">#5E2A2D</color>
    <color name="status_on_error_container">#FCDADA</color>
    <color name="status_info">#7CCBEF</color>
    <color name="status_info_container">#1D4A5C</color>
    <color name="status_on_info_container">#C9ECFA</color>
    <color name="status_neutral">#C8CED8</color>
    <color name="status_neutral_container">#3A4252</color>
    <color name="status_on_neutral_container">#E4E8EF</color>

    <!-- RTK / GNSS status chips – night (light on dark; previously no override: #2E7D32 was 3.5:1) -->
    <color name="status_single">@color/status_neutral</color>
    <color name="app_primary">#A8C6FF</color>
    <color name="app_on_primary">#0F2A55</color>
    <color name="app_primary_container">#293F61</color>
    <color name="app_on_primary_container">#D9E5FF</color>
    <color name="app_secondary">#B9C5D6</color>
    <color name="app_on_secondary">#1C2533</color>
    <color name="app_secondary_container">#3A4658</color>
    <color name="app_on_secondary_container">#DCE3ED</color>
    <color name="app_background">#1B202B</color>
    <color name="app_on_background">#F0F2F7</color>
    <color name="app_surface">#303746</color>
    <color name="app_on_surface">#F0F2F7</color>
    <color name="app_surface_variant">#292F3D</color>
    <color name="app_on_surface_variant">#C8CED8</color>
    <color name="app_surface_container">#292F3D</color>
    <color name="app_surface_container_high">#394253</color>
    <color name="app_surface_container_highest">#3C4555</color>
    <color name="app_outline">#8D97A8</color>
    <color name="app_outline_variant">#505B6F</color>

    <!-- Coordinate list / card – darker stripe for night -->
    <color name="coordinate_row_even">#FF1E2024</color>
    <color name="coordinate_row_odd">#FF252A2E</color>
    <color name="coordinate_list_bg">@color/app_background</color>

    <!-- Developer panel – night versions -->
    <color name="dev_panel_bg">#FF1E2124</color>
