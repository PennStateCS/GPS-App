<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (night). -->
    <style name="Theme.SurveyingApp" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Neutral surfaces (override M3 tonal tinting) -->
        <item name="colorSurface">#FF1C1B1F</item>
        <item name="colorOnSurface">#FFE6E1E5</item>
        <item name="colorSurfaceVariant">#FF2B2B2B</item>
        <item name="colorOnSurfaceVariant">#FFCAC4D0</item>
        <item name="colorOutlineVariant">#FF444444</item>
        <item name="android:colorBackground">#FF1C1B1F</item>
    </style>
</resources>
