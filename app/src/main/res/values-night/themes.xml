<resources>
    <!--
        Night/dark overrides for Theme.SurveyingApp.
        M3 dark theme convention: primary uses T80 (light on dark surface),
        containers use T30 (dark enough to contrast with T80 content).
    -->
    <style name="Theme.SurveyingApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ── Primary: Cobalt (dark) ─────────────────────────────────────── -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/app_inverse_primary</item>

        <!-- ── Secondary: Slate (dark) ────────────────────────────────────── -->
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>
        <item name="colorSecondaryContainer">@color/app_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_secondary_container</item>

        <!-- ── Tertiary: Amber (dark) ─────────────────────────────────────── -->
        <item name="colorTertiary">@color/md_tertiary_80</item>
        <item name="colorOnTertiary">@color/md_tertiary_20</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_30</item>
        <item name="colorOnTertiaryContainer">@color/md_tertiary_90</item>

        <!-- ── Error (dark) ───────────────────────────────────────────────── -->
        <item name="colorError">@color/app_error</item>
        <item name="colorOnError">@color/app_on_error</item>
        <item name="colorErrorContainer">@color/app_error_container</item>
        <item name="colorOnErrorContainer">@color/app_on_error_container</item>

        <!-- ── Surfaces (dark) ────────────────────────────────────────────── -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/app_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/app_inverse_on_surface</item>

        <!-- ── Surface Containers (dark) ─────────────────────────────────── -->
        <!-- Explicitly defined to prevent fallback to M3's default purple palette. -->
        <item name="colorSurfaceContainerLowest">@color/app_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/app_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_highest</item>
        <item name="colorSurfaceDim">@color/app_surface_dim</item>
        <item name="colorSurfaceBright">@color/app_surface_bright</item>

        <!-- ── Background (dark) ──────────────────────────────────────────── -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/app_on_background</item>

        <!-- ── Outline (dark) ─────────────────────────────────────────────── -->
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline_variant</item>

        <!-- ── System bars (dark) ─────────────────────────────────────────── -->
        <item name="android:statusBarColor">@color/app_top_app_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/app_background</item>

        <!-- ── Overflow / popup menu (dark) ──────────────────────────────── -->
        <item name="actionOverflowMenuStyle">@style/Widget.App.OverflowMenu</item>
        <item name="popupMenuStyle">@style/Widget.App.OverflowMenu</item>

        <!-- ── Semantic status roles (values/attrs.xml, docs/design-system.md) ── -->
        <item name="colorStatusSuccess">@color/status_success</item>
        <item name="colorStatusSuccessContainer">@color/status_success_container</item>
        <item name="colorOnStatusSuccessContainer">@color/status_on_success_container</item>
        <item name="colorStatusWarning">@color/status_warning</item>
        <item name="colorStatusWarningContainer">@color/status_warning_container</item>
        <item name="colorOnStatusWarningContainer">@color/status_on_warning_container</item>
        <item name="colorStatusError">@color/status_error</item>
        <item name="colorStatusErrorContainer">@color/status_error_container</item>
        <item name="colorOnStatusErrorContainer">@color/status_on_error_container</item>
        <item name="colorStatusInfo">@color/status_info</item>
        <item name="colorStatusInfoContainer">@color/status_info_container</item>
        <item name="colorOnStatusInfoContainer">@color/status_on_info_container</item>
        <item name="colorStatusNeutral">@color/status_neutral</item>
        <item name="colorStatusNeutralContainer">@color/status_neutral_container</item>
        <item name="colorOnStatusNeutralContainer">@color/status_on_neutral_container</item>

        <!-- ── Type: M3 label-small (11 sp) raised to the 12 sp minimum ── -->
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>

    </style>

    <!--
        Dark-mode popup overlay.  Parent is ThemeOverlay.Material3.Dark so the
        M3 base values (error, tertiary, etc.) are dark-appropriate.  Explicit
        @color/app_* overrides resolve to their values-night variants
        automatically, giving a dark blue-gray popup surface in dark mode.
    -->
    <style name="Theme.SurveyingApp.PopupOverlay" parent="ThemeOverlay.Material3.Dark">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorSecondaryContainer">@color/app_primary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_highest</item>
        <item name="android:colorBackground">@color/app_surface_container_high</item>
        <item name="colorControlHighlight">@color/app_control_highlight</item>
        <item name="android:textColorPrimary">@color/app_on_surface</item>
        <item name="android:textColorSecondary">@color/app_on_surface_variant</item>
    </style>

</resources>
