<?xml version="1.0" encoding="utf-8"?><!--
   Cloud backup / device transfer rules (API 31+). See:
   https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Cloud backup excludes transient diagnostic logs (may reference local paths/IPs) and large
   imported model/thumbnail files (backup-size bloat; re-importable). The Room database (saved
   coordinates + model metadata) and preferences are left included so the user's own data restores.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="thumbnails/" />
    </cloud-backup>
    <!-- Device-to-device transfer keeps everything (local transfer; size is not a concern). -->
</data-extraction-rules>
