<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext is permitted because external GNSS receivers (Emlid Reach / RS2+) are reached over
        plain HTTP/TCP on the local network (e.g. 192.168.x.x / 10.x) and do not present TLS certs.
        It is intentionally global because the receiver's local IP is user-configurable and not known
        ahead of time, so it cannot be scoped to a fixed domain. No app traffic to public endpoints
        relies on cleartext.

        HTTPS trusts the system certificates only. User-installed CAs (for proxying traffic during
        development) are trusted in debuggable builds only, through debug-overrides, so a release build
        never accepts a CA someone added to the tablet (it could read the Maps/ARCore requests).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
