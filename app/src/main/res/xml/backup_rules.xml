<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules used on API < 31 (API 31+ uses data_extraction_rules.xml).
   Excludes transient diagnostic logs and large imported model/thumbnail files from cloud backup;
   the Room database (saved coordinates + model metadata) and preferences remain backed up so the
   user's own data restores.
-->
<full-backup-content>
    <exclude domain="file" path="diagnostics/" />
    <exclude domain="file" path="models/" />
    <exclude domain="file" path="thumbnails/" />
</full-backup-content>
