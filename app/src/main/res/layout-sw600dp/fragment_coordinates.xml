<?xml version="1.0" encoding="utf-8"?>
<!--
    Tablet (sw600dp+) two-pane coordinator layout.
    - list_pane_container (weight=3): collapsible left list pane
    - list_pane_divider: 1dp vertical separator
    - coord_detail_container (weight=7): detail pane, fills remainder
    All IDs required by FragmentCoordinatesBinding are present:
    pointsRecyclerView, emptyCoordinatesText (LinearLayout), fab_add_coordinate.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ── LEFT: List pane ──────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/list_pane_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Pane header: title + collapse button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:background="?attr/colorSurfaceContainerHigh"
                    android:elevation="0dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Coordinates"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageButton
                        android:id="@+id/btn_collapse_list"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Collapse list"
                        android:src="@drawable/ic_chevron_right"
                        android:rotation="180"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- Hairline separator below header -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Content area: RecyclerView + empty state overlay -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/pointsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingBottom="80dp"
                        android:clipToPadding="false"
                        android:scrollbars="vertical" />

                    <!-- Empty state — LinearLayout matches phone layout contract for ViewBinding -->
                    <LinearLayout
                        android:id="@+id/emptyCoordinatesText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginBottom="16dp"
                            android:src="@drawable/ic_list_coordinates"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No coordinates saved"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap + to capture the current GNSS position"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- FAB overlaid at bottom-end of list pane -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_coordinate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="@string/capture_coordinates"
                android:src="@drawable/ic_stat_location"
                app:backgroundTint="?attr/colorPrimaryContainer"
                app:tint="?attr/colorOnPrimaryContainer" />

        </FrameLayout>

        <!-- ── Vertical divider ──────────────────────────────────────────── -->
        <View
            android:id="@+id/list_pane_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant" />

        <!-- ── RIGHT: Detail pane ────────────────────────────────────────── -->
        <!-- The "show list" control when collapsed lives in the detail header
             (CoordinateDetailFragment), so it never overlaps the title. -->
        <FrameLayout
            android:id="@+id/coord_detail_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:background="?android:attr/colorBackground" />

    </LinearLayout>

</FrameLayout>
