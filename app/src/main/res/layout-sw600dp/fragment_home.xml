<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Top Row: Location and Statistics with Quick Actions side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:baselineAligned="false">

            <!-- Left Column: Location and Map -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <!-- Current Location Info Card (with map) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_section_location"
                                android:layout_marginEnd="8dp"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Current Location"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />

                            <!-- Header action: opens the full Map page (same destination as the
                                 Quick Actions "Open Map" chip). Kept in the header so it never
                                 conflicts with the interactive map preview's pan/zoom gestures. -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_open_full_map"
                                style="@style/Widget.App.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:text="Open Map"
                                android:contentDescription="@string/home_open_full_map_desc"
                                app:icon="@drawable/ic_chevron_right"
                                app:iconGravity="end"
                                app:iconSize="18dp"
                                app:iconPadding="2dp" />

                        </LinearLayout>

                        <!-- Fix Badge for GNSS quality and stream health indicators -->
                        <app.surrealar.ui.components.FixBadgeView
                            android:id="@+id/fix_badge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone" />

                        <!-- Map View that fills remaining space in location card -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_map_rounded"
                            android:clipToOutline="false">

                            <com.google.android.gms.maps.MapView
                                android:id="@+id/map_view_mini"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- Overlay for when map is not available -->
                            <LinearLayout
                                android:id="@+id/layout_map_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:visibility="gone"
                                android:background="@drawable/bg_rounded_light">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/ic_render_map"
                                    android:layout_marginBottom="12dp"
                                    android:alpha="0.5"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/text_map_placeholder"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Acquiring location…"
                                    android:textAppearance="@style/TextAppearance.App.BodySecondary"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                            </LinearLayout>

                            <!-- Map controls overlay (top-right) -->
                            <LinearLayout
                                android:id="@+id/container_map_controls"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:orientation="horizontal"
                                android:padding="8dp">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_map_type"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Map Type"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    app:chipIcon="@drawable/ic_map"
                                    app:chipIconVisible="true"
                                    app:chipIconSize="16dp"
                                    app:chipIconTint="?attr/colorOnSurface"
                                    app:iconStartPadding="8dp"
                                    app:rippleColor="?attr/colorControlHighlight" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_toggle_3d"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3D"
                                    android:checkable="true"
                                    android:checked="true"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    app:chipIcon="@drawable/ic_triangle"
                                    app:chipIconVisible="true"
                                    app:chipIconSize="16dp"
                                    app:chipIconTint="?attr/colorOnSurface"
                                    app:iconStartPadding="8dp"
                                    app:rippleColor="?attr/colorControlHighlight"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Right Column: Insights Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <!-- Field Status Card — plain-language position-quality summary (complements the
                     dense app-wide GNSS toolbar; populated by HomeFieldStatusMapper). -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_satellite_24"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="@null"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Field Status"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_field_status_action"
                                style="@style/Widget.App.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="36dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:text="Open Map"
                                android:contentDescription="@string/home_open_full_map_desc"
                                app:icon="@drawable/ic_chevron_right"
                                app:iconGravity="end"
                                app:iconSize="18dp"
                                app:iconPadding="2dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/field_status_dot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_field_status_dot" />

                            <TextView
                                android:id="@+id/text_field_status_headline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Waiting for live position…"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                        </LinearLayout>

                        <!-- Always-visible skeleton (values update in place) for a stable height. -->
                        <TextView
                            android:id="@+id/text_field_status_detail_primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="18dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="--"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/text_field_status_receiver"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginStart="18dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="--"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Reserve a stable two-row chip area so the card height does not jump
                             as chips arrive/wrap on the narrower tablet column. -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/group_field_status_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="18dp"
                            android:minHeight="72dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="6dp"
                            app:singleLine="false" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Quick Actions Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Card Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_tune_24"
                                android:layout_marginEnd="8dp"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Quick Actions"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp">

                            <!-- Open Map = primary emphasis (most common action) -->
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_quick_map"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open Map"
                                android:textColor="?attr/colorOnPrimary"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipIcon="@drawable/ic_render_map"
                                app:chipIconVisible="true"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnPrimary"
                                app:iconStartPadding="8dp"
                                app:chipBackgroundColor="?attr/colorPrimary" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_quick_ar"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open AR"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipIcon="@drawable/ic_section_ar"
                                app:chipIconVisible="true"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnPrimaryContainer"
                                app:iconStartPadding="8dp"
                                app:chipBackgroundColor="?attr/colorPrimaryContainer" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_quick_settings"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Settings"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipIcon="@drawable/ic_settings_24"
                                app:chipIconVisible="true"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnPrimaryContainer"
                                app:iconStartPadding="8dp"
                                app:chipBackgroundColor="?attr/colorPrimaryContainer" />

                        </com.google.android.material.chip.ChipGroup>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Survey Data Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Card Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_section_data"
                                android:layout_marginEnd="8dp"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Survey Data"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <!-- Coordinates row (compact) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_list_coordinates"
                                android:layout_marginEnd="12dp"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Coordinates"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/text_coordinates_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="12dp"
                                android:textColor="?attr/colorPrimary" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_view_coordinates"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View"
                                android:textColor="?attr/colorOnPrimary"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipBackgroundColor="?attr/colorPrimary" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Models row (compact) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_models_24"
                                android:layout_marginEnd="12dp"
                                app:tint="?attr/colorSecondary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Models"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/text_models_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="12dp"
                                android:textColor="?attr/colorSecondary" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_view_models"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View"
                                android:textColor="?attr/colorOnSecondary"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipBackgroundColor="?attr/colorSecondary" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

