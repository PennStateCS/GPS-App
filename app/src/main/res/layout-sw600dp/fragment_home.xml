<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Top Row: Location and Statistics with Quick Actions side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:baselineAligned="false">

            <!-- Left Column: Location and Map -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <!-- Current Location Info Card (with map) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@color/card_stroke_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_section_location"
                                android:layout_marginEnd="6dp"
                                app:tint="?android:attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Current Location"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary" />

                        </LinearLayout>

                        <!-- Fix Badge for GNSS quality and stream health indicators -->
                        <com.example.surveyingapp.ui.components.FixBadgeView
                            android:id="@+id/fix_badge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone" />

                        <!-- Map View that fills remaining space in location card -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_map_rounded"
                            android:clipToOutline="true">

                            <com.google.android.gms.maps.MapView
                                android:id="@+id/map_view_mini"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <!-- Overlay for when map is not available -->
                            <LinearLayout
                                android:id="@+id/layout_map_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:visibility="gone"
                                android:background="@drawable/bg_rounded_light">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/ic_render_map"
                                    android:layout_marginBottom="12dp"
                                    android:alpha="0.5"
                                    app:tint="?android:attr/textColorSecondary" />

                                <TextView
                                    android:id="@+id/text_map_placeholder"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Acquiring location…"
                                    android:textSize="14sp"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                            <!-- Map controls overlay (top-right) -->
                            <LinearLayout
                                android:id="@+id/container_map_controls"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:orientation="horizontal"
                                android:padding="8dp">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_map_type"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Map Type"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    app:chipIcon="@drawable/ic_map"
                                    app:chipIconVisible="true"
                                    app:chipIconSize="16dp"
                                    app:chipIconTint="?android:attr/textColorPrimary"
                                    app:iconStartPadding="8dp"
                                    app:rippleColor="?attr/colorControlHighlight" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_toggle_3d"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3D"
                                    android:checkable="true"
                                    android:checked="true"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    app:chipIcon="@drawable/ic_triangle"
                                    app:chipIconVisible="true"
                                    app:chipIconSize="16dp"
                                    app:chipIconTint="?android:attr/textColorPrimary"
                                    app:iconStartPadding="8dp"
                                    app:rippleColor="?attr/colorControlHighlight"
                                    android:layout_marginStart="8dp" />

                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Right Column: Insights Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <!-- Insights Card (combining Statistics and Quick Actions) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@color/card_stroke_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Card Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_section_info"
                                android:layout_marginEnd="6dp"
                                app:tint="?android:attr/colorPrimary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Insights"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary" />

                        </LinearLayout>

                        <!-- Metrics Section -->
                        <!-- RS2+ Summary (visible only when external source is active) -->
                        <TextView
                            android:id="@+id/text_rs2_summary_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RS2+ Device"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/container_rs2_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_rounded_card"
                            android:padding="10dp"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Name"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/text_rs2_name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="--"
                                    android:textColor="?android:attr/textColorPrimary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Address"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/text_rs2_address"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="--"
                                    android:textColor="?android:attr/textColorPrimary" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Survey Data"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginBottom="8dp" />

                        <!-- Coordinates Count -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_rounded_card"
                            android:padding="10dp"
                            android:layout_marginBottom="6dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_compass"
                                android:layout_marginEnd="8dp"
                                android:layout_gravity="center_vertical"
                                app:tint="?android:attr/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_coordinates_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Coordinates"
                                    android:textSize="10sp"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_view_coordinates"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View"
                                android:textColor="@android:color/white"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipBackgroundColor="?android:attr/colorPrimary"
                                android:layout_gravity="center_vertical" />

                        </LinearLayout>

                        <!-- Models Count -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_rounded_card"
                            android:padding="10dp"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_menu_gallery"
                                android:layout_marginEnd="8dp"
                                android:layout_gravity="center_vertical"
                                app:tint="?android:attr/colorAccent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_models_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/colorAccent" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Models"
                                    android:textSize="10sp"
                                    android:textColor="?android:attr/textColorSecondary" />

                            </LinearLayout>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_view_models"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View"
                                android:textColor="@android:color/white"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipBackgroundColor="@color/chip_map_bg"
                                android:layout_gravity="center_vertical" />

                        </LinearLayout>

                        <!-- Quick Actions Section -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quick Actions"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_quick_map"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open Map"
                                android:textColor="@android:color/white"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipIcon="@drawable/ic_render_map"
                                app:chipIconVisible="true"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@android:color/white"
                                app:iconStartPadding="8dp"
                                app:chipBackgroundColor="@color/chip_map_bg" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_quick_ar"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open AR"
                                android:textColor="@android:color/white"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipIcon="@drawable/ic_section_ar"
                                app:chipIconVisible="true"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@android:color/white"
                                app:iconStartPadding="8dp"
                                app:chipBackgroundColor="@color/chip_map_bg" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_quick_settings"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Settings"
                                android:textColor="@android:color/white"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                app:chipIcon="@drawable/ic_section_info"
                                app:chipIconVisible="true"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@android:color/white"
                                app:iconStartPadding="8dp"
                                app:chipBackgroundColor="@color/chip_map_bg" />

                        </com.google.android.material.chip.ChipGroup>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

