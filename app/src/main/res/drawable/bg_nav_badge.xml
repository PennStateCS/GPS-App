<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle rounded pill behind a drawer count badge. Neutral surface-container fill so it reads
     as part of the drawer (not a notification alert) and stays legible on both the plain row and
     the selected pill, in light and dark mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <corners android:radius="11dp" />
</shape>
