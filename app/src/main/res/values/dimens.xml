<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="nav_header_vertical_spacing">8dp</dimen>
    <dimen name="nav_header_height">128dp</dimen>
    <dimen name="nav_drawer_width">304dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="coord_item_spacing">2dp</dimen>
    <dimen name="coord_horizontal_padding">2dp</dimen>
    <!-- Slightly smaller text size for coordinate detail table cells -->
    <dimen name="coord_table_text_size">14sp</dimen>
    <!-- Responsive horizontal padding for settings content pages -->
    <dimen name="settings_content_padding_h">24dp</dimen>
    <!-- Responsive padding for general page content -->
    <dimen name="page_content_padding">16dp</dimen>
    <!-- Vertical padding for setting rows (item_settings_row). Tablet override: 11dp -->
    <dimen name="settings_row_padding_v">16dp</dimen>
    <!-- Vertical padding for inline rows inside content_settings pages. Tablet override: 10dp -->
    <dimen name="settings_content_row_padding_v">14dp</dimen>
    <!-- Width of exposed-dropdown value selectors in settings rows. Wide enough that longer
         options (e.g. "System Default") stay on one line; selected text is singleLine and
         ellipsizes if an option is longer than this. Phone-safe here; widened on tablet
         (values-sw600dp) where there is more horizontal room. -->
    <dimen name="settings_dropdown_width">200dp</dimen>
</resources>