    <!-- ══════════════════════════════════════════════════════════════════════
         APP SEMANTIC COLORS  (light)
         Named app_* so they can be overridden in values-night/colors.xml and
         referenced from themes.xml with no hard-coded hex values in themes.
    ══════════════════════════════════════════════════════════════════════════ -->

    <!-- Top app bar – darkest layer: very deep navy brand bar -->
    <color name="app_top_app_bar">#071A2D</color>
    <color name="app_on_top_app_bar">#FFFFFF</color>

    <!-- GNSS/source status strip – lighter blue-navy "instrument strip", clearly above the top bar.
         on_status_strip   = primary VALUE text (near-white, bold readings)
         _variant          = secondary LABEL text (soft blue-gray)
         separator         = subtle vertical dividers between tokens -->
    <color name="app_status_strip">#0F3554</color>
    <color name="app_on_status_strip">@color/toolbar_on_primary</color>
    <color name="app_on_status_strip_variant">@color/toolbar_on_secondary</color>
    <color name="app_status_separator">#6F8598</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEMANTIC STATUS ROLES  (light; night values in values-night/colors.xml)
         Purpose-named, three colors per role:
           status_<role>                 foreground: text / icon / indicator on surface, background
                                         and surface containers (≥ 4.5:1 on all of them)
           status_<role>_container       fill for badges, banners, chips (never used as text)
           status_on_<role>_container    text / icon on that fill (≥ 4.5:1)
         Resolve them from views through the theme attributes in values/attrs.xml
         (?attr/colorStatusWarning …) or with getColor(R.color.status_warning).
         Contrast is enforced by SemanticPaletteContrastTest (light + night).
         See docs/design-system.md.
    ══════════════════════════════════════════════════════════════════════════ -->
    <color name="status_success">#1E6B2A</color>                 <!-- 6.6:1 on white -->
    <color name="status_success_container">#CDEBD2</color>
    <color name="status_on_success_container">#0B3D14</color>
    <color name="status_warning">#9A4700</color>                 <!-- 6.4:1 on white (was #E65100, 3.8:1) -->
    <color name="status_warning_container">#FFDEA8</color>
    <color name="status_on_warning_container">#2E1A00</color>
    <color name="status_error">#BA1A1A</color>                   <!-- 6.5:1 on white; = colorError -->
    <color name="status_error_container">#FFDAD6</color>
    <color name="status_on_error_container">#410002</color>
    <color name="status_info">#155DA8</color>                    <!-- 6.6:1 on white; = colorPrimary -->
    <color name="status_info_container">#D7E8FF</color>
    <color name="status_on_info_container">#001B44</color>
    <color name="status_neutral">#41484D</color>                 <!-- 9.3:1 on white; = colorOnSurfaceVariant -->
    <color name="status_neutral_container">#E3E7ED</color>
    <color name="status_on_neutral_container">#1A1C1E</color>

    <!-- Legacy names kept as aliases (Home field status, readiness, GNSS report, AR sheets use them). -->
    <color name="app_success">@color/status_success</color>
    <color name="app_warning">@color/status_warning</color>
    <color name="app_error">@color/status_error</color>
    <color name="app_info">@color/status_info</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         GNSS TOOLBAR FOREGROUND ROLES
         The strip (app_status_strip #0F3554) is navy in BOTH themes, so these are the same in
         both themes (no night override). Only for text/icons drawn on the strip — not global
         semantics. All ≥ 6.4:1 on #0F3554 (GnssToolbarContrastTest).
    ══════════════════════════════════════════════════════════════════════════ -->
    <color name="toolbar_on_primary">#F2F6FA</color>     <!-- values, 11.7:1 -->
    <color name="toolbar_on_secondary">#B8C7D6</color>   <!-- labels, chevron, NONE level, 7.3:1 -->
    <color name="toolbar_success">#81C995</color>        <!-- RTK Fix, good accuracy, 6.5:1 -->
    <color name="toolbar_warning">#F7C66A</color>        <!-- Float, aging, 8.0:1 -->
    <color name="toolbar_error">#FFAAA5</color>          <!-- no fix, error, 7.0:1 -->
    <color name="toolbar_info">#9CC8FF</color>           <!-- DGPS / informational, 7.3:1 -->

    <!-- Light-on-dark status text over AR camera overlays (ar_overlay_bg_*, ≥ 73 % black):
         same values as the toolbar roles, named by purpose so they can diverge later. -->
    <color name="ar_overlay_success">@color/toolbar_success</color>
    <color name="ar_overlay_warning">@color/toolbar_warning</color>
    <color name="ar_overlay_error">@color/toolbar_error</color>
    <color name="ar_overlay_info">@color/toolbar_info</color>

    <!-- Primary – professional blue (#155DA8) -->
    <color name="app_primary">#155DA8</color>
    <color name="app_on_primary">#FFFFFF</color>
    <color name="app_primary_container">#D7E8FF</color>
    <color name="app_on_primary_container">#001B44</color>

    <!-- Secondary – GNSS/success teal (#00796B) -->
    <color name="app_secondary">#00796B</color>
    <color name="app_on_secondary">#FFFFFF</color>
    <color name="app_secondary_container">#BFEDE6</color>
    <color name="app_on_secondary_container">#002019</color>

    <!-- Background – soft neutral blue-gray -->
    <color name="app_background">#F4F7FA</color>
    <color name="app_on_background">#1A1C1E</color>

    <!-- Surface / cards -->
    <color name="app_surface">#FFFFFF</color>
