    <color name="map_label_text">#FFFFFFFF</color>
    <color name="map_grid_line">#80616161</color>        <!-- 50 % mid-gray – survey meter grid (reads on light + satellite tiles) -->

    <!-- GNSS / satellite charts (SatelliteSignalChartView, SkyplotView, SnrBarView) ─────────────
