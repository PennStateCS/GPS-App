    <!-- Compact GNSS toolbar warning pill (on the navy strip, both themes): icon + text on a filled pill.
         critical = red / white (5.6:1) with a light-red 1 dp outline so the pill edge reads on navy
         (the red fill alone is only 2.3:1 against #0F3554), caution = amber / near-black (9.7:1; fill 7.1:1). -->
    <color name="gnss_toolbar_warning_critical_bg">#C62828</color>
    <color name="gnss_toolbar_warning_critical_stroke">@color/toolbar_error</color>
    <color name="gnss_toolbar_warning_critical_fg">#FFFFFF</color>
    <color name="gnss_toolbar_warning_caution_bg">#FFB300</color>
    <color name="gnss_toolbar_warning_caution_fg">#1A1A1A</color>

    <!-- Model viewer canvas ───────────────────────────────────────────────
         The Filament skybox / clear colour in ModelViewerActivity is a fixed light grey
         (BACKGROUND_GREY = 0.93) in both themes (rendering, not themed). The loading overlay must
         match it so the reveal does not flash, so it stays fixed and text drawn over it uses fixed
         dark colours instead of the theme's onSurface (which is near-white in dark mode). -->
    <color name="model_viewer_canvas">#EEEEEE</color>
    <color name="model_viewer_on_canvas">#1A1C1E</color>          <!-- 14.7:1 -->
    <color name="model_viewer_on_canvas_error">#BA1A1A</color>    <!-- 5.6:1 -->
    <color name="model_viewer_on_canvas_accent">@color/md_primary_40</color>  <!-- spinner, 5.9:1 (night primary #8FC5FF was 1.5:1) -->

</resources>
