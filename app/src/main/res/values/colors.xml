    <!-- Surface Container family (light) – neutral blue-gray, overrides M3 purple defaults -->
    <!-- Steps from near-white (lowest) to lightest visible container (highest).            -->
    <!-- Used by dropdowns, dialogs, nav drawer, bottom sheets, and other M3 surfaces.      -->
    <color name="md_surface_container_lowest">#FFFFFF</color>  <!-- pure white elevated card -->
    <color name="md_surface_container_low">#F5F7FB</color>     <!-- barely-there blue-gray   -->
    <color name="md_surface_container">#EFF2F6</color>         <!-- standard container        -->
