<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Small pill badge on a model card ("2 linked", "Georeferenced", "File missing").
         Set backgroundTint + textColor per badge. -->
    <style name="Widget.App.ModelBadge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_model_badge</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">@style/TextAppearance.App.StatusLabel</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- One line in the readiness dialog's "Details" footer. -->
    <style name="Widget.App.ReadinessDetail" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
