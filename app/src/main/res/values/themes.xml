<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SurveyingApp" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Neutral surfaces (override M3 tonal tinting) -->
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1C1B1F</item>
        <item name="colorSurfaceVariant">#FFF4F4F4</item>
        <item name="colorOnSurfaceVariant">#FF49454F</item>
        <item name="colorOutlineVariant">#FFE0E0E0</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
    </style>

    <style name="Theme.SurveyingApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
        Used by ThumbnailCaptureActivity so it is completely invisible to the user.
        windowIsTranslucent keeps the previous activity visible behind it.
        The activity itself sets a tiny window size and positions it behind the status bar
        so the GPU still renders the Filament surface (alpha=0 prevents GPU rendering).
        No animations so there is no visual glitch.
    -->
    <style name="Theme.SurveyingApp.ThumbnailCapture" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.SurveyingApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.SurveyingApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
