<resources>
    <!--
        Base application theme.
        Parent: Theme.Material3.DayNight.NoActionBar
        All activities manage their own Toolbar; the window ActionBar is always disabled.

        Palette: Deep Blue primary / Teal secondary / Amber tertiary.
        Designed for a professional field/surveying context.
        Tonal values derived from M3 tonal palette conventions (T40 for light, T80 for dark).
    -->
    <style name="Theme.SurveyingApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ── Primary: Professional Blue ────────────────────────────────── -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_primary_80</item>

        <!-- ── Secondary: GNSS/Success Teal ──────────────────────────────── -->
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/app_on_secondary</item>
        <item name="colorSecondaryContainer">@color/app_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_on_secondary_container</item>

        <!-- ── Tertiary: Amber (warning / caution states) ─────────────────── -->
        <item name="colorTertiary">@color/md_tertiary_40</item>
        <item name="colorOnTertiary">@color/md_tertiary_100</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_90</item>
        <item name="colorOnTertiaryContainer">@color/md_tertiary_10</item>

        <!-- ── Error ──────────────────────────────────────────────────────── -->
        <item name="colorError">@color/md_error_40</item>
        <item name="colorOnError">@color/md_error_100</item>
        <item name="colorErrorContainer">@color/md_error_90</item>
        <item name="colorOnErrorContainer">@color/md_error_10</item>

        <!-- ── Surfaces ───────────────────────────────────────────────────── -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_neutral_20</item>
        <item name="colorOnSurfaceInverse">@color/md_neutral_95</item>

        <!-- ── Surface Containers ─────────────────────────────────────────── -->
        <!-- Explicitly defined to prevent fallback to M3's default purple palette. -->
        <!-- colorSurfaceContainerHigh is the dropdown/menu/dialog popup background. -->
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_highest</item>

        <!-- ── Background ─────────────────────────────────────────────────── -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/app_on_background</item>

        <!-- ── Outline ────────────────────────────────────────────────────── -->
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline_variant</item>

        <!-- ── System bars ────────────────────────────────────────────────── -->
        <!-- Status bar matches the dark-navy toolbar; light icons on dark bg. -->
        <item name="android:statusBarColor">@color/app_top_app_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/app_background</item>

        <!-- ── Overflow / popup menu ──────────────────────────────────────── -->
        <!-- Belt-and-suspenders: ensures the overflow popup uses our          -->
        <!-- blue-gray surface regardless of which M3 rendering path is taken. -->
        <item name="actionOverflowMenuStyle">@style/Widget.App.OverflowMenu</item>
        <item name="popupMenuStyle">@style/Widget.App.OverflowMenu</item>

    </style>

    <!--
        Applied to activities that manage a custom Toolbar (most of the app).
        Inherits all colour tokens from Theme.SurveyingApp; only present so the
        manifest entries that reference it continue to resolve.
    -->
    <style name="Theme.SurveyingApp.NoActionBar" />

    <!--
        Overflow popup menu background — neutral blue-gray, no purple.
        Referenced from both Theme.SurveyingApp and Theme.SurveyingApp.PopupOverlay.
        Using android:popupBackground as a belt-and-suspenders override in case
        the M3 popup rendering path ignores colorSurfaceContainerHigh.
    -->
    <style name="Widget.App.OverflowMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!--
        Used by ThumbnailCaptureActivity — completely invisible to the user.
        windowIsTranslucent keeps the previous activity visible behind it while
        the Filament surface renders. No animations to avoid visual glitches.
    -->
    <style name="Theme.SurveyingApp.ThumbnailCapture" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
        Toolbar overlay for dark-background toolbars (e.g. ModelViewerActivity).
        Replaced ThemeOverlay.AppCompat.Dark.ActionBar with the M3 equivalent.
    -->
    <style name="Theme.SurveyingApp.AppBarOverlay" parent="ThemeOverlay.Material3.Dark" />

    <!--
        Popup overlay for the overflow menu anchored to the dark-navy toolbar.
        Parent provides the Light framing; the overrides below replace every
        purple-prone color with the app's neutral blue-gray palette so the
        popup background, text, and ripple states are all purple-free.
        @color/app_* references resolve to their values-night variants automatically
        when the device is in dark mode, giving a dark-neutral popup in dark mode.
    -->
    <style name="Theme.SurveyingApp.PopupOverlay" parent="ThemeOverlay.Material3.Light">
        <!-- Primary / secondary – prevents purple selected/checked state -->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorSecondaryContainer">@color/app_primary_container</item>
        <!-- Surface / popup background -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/app_surface_container_highest</item>
        <!-- Window background used by older popup path and AppCompat fallback -->
        <item name="android:colorBackground">@color/app_surface_container_high</item>
        <!-- Ripple / pressed overlay – 10 % primary blue -->
        <item name="colorControlHighlight">#1A155DA8</item>
        <!-- Text -->
        <item name="android:textColorPrimary">@color/app_on_surface</item>
        <item name="android:textColorSecondary">@color/app_on_surface_variant</item>
    </style>

</resources>
