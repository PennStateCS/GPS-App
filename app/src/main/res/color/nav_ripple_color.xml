<?xml version="1.0" encoding="utf-8"?>
<!-- Ripple color for nav drawer items (Material 3 pressed state layer).
     Selected: 12% primary layered over the selection pill.
     Unselected: 12% on-surface-variant so the press reads clearly on the plain
     surface, at the same strength as a selected-item press.
     Theme attributes (not the light-only hex it used to be) so the press layer is
     visible on the dark drawer too; the light values are unchanged. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorPrimary" android:alpha="0.12" />
    <item android:color="?attr/colorOnSurfaceVariant" android:alpha="0.12" />
</selector>
